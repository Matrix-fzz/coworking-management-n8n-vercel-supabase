{
  "name": "AI Agent - Coworking Management",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-agent",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [820, 300],
      "id": "webhook-ai-agent",
      "name": "Webhook",
      "webhookId": "ai-agent-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract the user message from webhook\nconst message = $input.item.json.body.message || $input.item.json.message || \"Hello\";\nconst history = $input.item.json.body.history || $input.item.json.history || [];\n\n// Format history for the AI\nlet conversationHistory = \"\";\nif (history && history.length > 0) {\n  conversationHistory = history.map(h => `${h.role}: ${h.text}`).join(\"\\n\");\n}\n\nreturn [\n  {\n    json: {\n      message: message,\n      history: conversationHistory,\n      userMessage: message\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300],
      "id": "extract-message",
      "name": "Extract Message"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "workspaces",
        "returnAll": true,
        "options": {
          "queryName": "select",
          "select": "name,description,location,price"
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1220, 300],
      "id": "get-workspaces",
      "name": "Get Workspaces (Optional)",
      "credentials": {
        "supabaseApi": {
          "id": "qFNekxEtcoapdFA5",
          "name": "Supabase account 9"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Prepare context for AI with workspace data\nconst userMessage = $input.first().json.userMessage;\nconst workspaces = $input.all().slice(1).map(item => item.json);\n\nlet context = \"Vous êtes un assistant IA pour un système de gestion de coworking. \";\n\nif (workspaces && workspaces.length > 0) {\n  context += `Voici les espaces de travail disponibles:\\n`;\n  workspaces.forEach((ws, i) => {\n    context += `${i+1}. ${ws.name} - ${ws.location} - ${ws.price}€/mois\\n`;\n  });\n} else {\n  context += \"Aucun espace de travail n'est actuellement disponible dans la base de données.\\n\";\n}\n\ncontext += `\\nQuestion de l'utilisateur: ${userMessage}\\n\\nRépondez de manière amicale et professionnelle.`;\n\nreturn [\n  {\n    json: {\n      prompt: context,\n      userMessage: userMessage\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 300],
      "id": "prepare-context",
      "name": "Prepare AI Context"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1620, 300],
      "id": "llm-chain",
      "name": "AI Chat"
    },
    {
      "parameters": {
        "model": "google/gemini-2.0-flash-exp:free",
        "options": {
          "baseURL": "https://openrouter.ai/api/v1",
          "temperature": 0.7,
          "maxTokens": 500
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [1620, 480],
      "id": "gemma-model",
      "name": "Gemma Model",
      "credentials": {
        "openAiApi": {
          "id": "onz6E2iEiZGwDclj",
          "name": "OpenAi account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format the response\nconst aiOutput = $input.first().json.output || $input.first().json.text || \"Désolé, je n'ai pas pu générer une réponse.\";\n\nreturn [\n  {\n    json: {\n      output: aiOutput,\n      response: aiOutput,\n      success: true\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 300],
      "id": "format-response",
      "name": "Format Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2020, 300],
      "id": "respond-webhook",
      "name": "Respond to Webhook"
    }
  ],
